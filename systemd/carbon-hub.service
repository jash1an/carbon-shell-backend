[Unit]
Description=Carbon Settings Hub Daemon (Rust IPC)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/carbon-hub-daemon
Restart=always
RestartSec=1
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
PassEnvironment=WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR

[Install]
WantedBy=default.target
