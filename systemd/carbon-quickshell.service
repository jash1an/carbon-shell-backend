[Unit]
Description=Carbon Quickshell Desktop Shell
After=graphical-session.target

[Service]
Type=simple
KillMode=process
EnvironmentFile=-%h/.config/carbon/carbon-shell.env
Environment=CARBON_CONFIG_DIR=%h/.config/carbon
Environment=QT_QPA_PLATFORM=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/bash -c 'if [ -x %h/.local/bin/quickshell ]; then exec %h/.local/bin/quickshell --config %h/.local/share/quickshell/carbon; elif command -v quickshell >/dev/null 2>&1; then exec quickshell --config %h/.local/share/quickshell/carbon; else exec /usr/bin/quickshell --config %h/.local/share/quickshell/carbon; fi'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
