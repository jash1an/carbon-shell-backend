#!/usr/bin/env bash
CONFIG_DIR="${CARBON_CONFIG_DIR:-$HOME/.config/carbon}"
HUB_SCRIPT="$CONFIG_DIR/scripts/carbon-settings-hub"
[ -f "$HUB_SCRIPT" ] || HUB_SCRIPT="$HOME/.config/hypr/scripts/carbon-settings-hub"
if [ -x "$HUB_SCRIPT" ]; then
    exec "$HUB_SCRIPT" "$@"
fi
exec "$HOME/.local/bin/carbon-settings-hub" "$@"
